# Server
PORT=5000

# MongoDB connection string
# Option A (Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/your-db-name?retryWrites=true&w=majority
# Option B (Local):  mongodb://localhost:27017/your-db-name
MONGO_URI=mongodb://localhost:27017/your-db-name

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Python AI microservice URL
AI_SERVICE_URL=http://localhost:8000/predict
